{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nitidoc-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "nitidoc-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "4173"],
      "port": 4173
    },
    {
      "name": "nitidoc-lan-https",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--host", "0.0.0.0", "--port", "4444"],
      "port": 4444,
      "url": "https://localhost:4444"
    },
    {
      "name": "nitidoc-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--host", "0.0.0.0", "--port", "4173"],
      "port": 4173
    },
    {
      "name": "landing",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "landing", "--port", "3999", "--strictPort"],
      "port": 3999
    }
  ]
}
