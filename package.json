{
  "name": "nitidoc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nitidoc — free, offline-first document scanner PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
