{
  "name": "nitidoc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nitidoc — free, offline-first document scanner PWA",
  "license": "AGPL-3.0-or-later",
  "author": "santiagoisra (https://github.com/santiagoisra)",
  "homepage": "https://nitidoc.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santiagoisra/nitidoc.git"
  },
  "bugs": {
    "url": "https://github.com/santiagoisra/nitidoc/issues"
  },
  "keywords": [
    "document-scanner",
    "pwa",
    "offline-first",
    "privacy",
    "opencv",
    "on-device",
    "pdf",
    "react"
  ],
  "scripts": {
    "copy-opencv": "node scripts/copy-opencv.mjs",
    "predev": "node scripts/copy-opencv.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-opencv.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/copy-opencv.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@techstark/opencv-js": "^4.10.0-release.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.10.6",
    "jpeg-js": "^0.4.4",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
